{
  "name": "ORBYN - main - integridad y CI",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "formato"
          },
          {
            "context": "codigo-sin-comentarios"
          },
          {
            "context": "compilacion"
          },
          {
            "context": "clippy"
          },
          {
            "context": "pruebas"
          },
          {
            "context": "documentacion-rust"
          },
          {
            "context": "dependencias"
          },
          {
            "context": "secretos"
          },
          {
            "context": "titulo-pr"
          },
          {
            "context": "issue-vinculado"
          }
        ]
      }
    }
  ]
}
